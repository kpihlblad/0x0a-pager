<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %t %-1level %msg %logger{36}%n</pattern>
        </encoder>
    </appender>

    <root level="${pager.log.level:-warn}">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>