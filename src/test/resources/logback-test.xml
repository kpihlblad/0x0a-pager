<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-1level %msg %logger{36}%n</pattern>
        </encoder>
    </appender>

    <root level="debug">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="se.grynna.pager.splunk.SplunkLogDataProvider" level="debug" />
    <logger name="se.grynna.pager.db.DatabaseManager" level="debug" />
    <logger name="se.grynna.pager.splunk.FieldSummary" level="debug" />

</configuration>